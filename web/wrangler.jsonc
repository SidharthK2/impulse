// The web app on Cloudflare: a Worker with static assets. web/dist is served from Cloudflare's edge (unknown paths
// get index.html, for client-side routes); /api/* and /ws go to worker/index.ts, which forwards them to the exchange
// on Fly. Deployed by .github/workflows/web-deploy.yml; setup in docs/DEPLOY.md.
{
  "name": "impulse-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "routes": [{ "pattern": "impulse.sidkap.xyz", "custom_domain": true }],
  // Only the custom domain: no impulse-web.<subdomain>.workers.dev copy, no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "API_ORIGIN": "https://impulse-sid.fly.dev"
  }
}
