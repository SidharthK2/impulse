{
  "name": "impulse-archive",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../reference/server",
    "golden": "tsx ../golden/generate.ts",
    "server:ts": "tsx ../reference/server/src/main.ts",
    "replay": "tsx ../sims/cli.ts",
    "demo": "tsx ../sims/cli.ts ../../tests/scenarios/gap-down-resolve-0.json ../../tests/scenarios/gap-down-resolve-1.json ../../tests/scenarios/gap-up-resolve-0.json ../../tests/scenarios/memecoin-squeeze.json ../../tests/scenarios/isolation-two-markets.json ../../tests/scenarios/attention-pump.json ../../tests/scenarios/principal-fallback.json ../../tests/scenarios/graduation-blowup.json ../../tests/scenarios/resolution-taper.json ../../tests/scenarios/funding-drain.json",
    "attack": "tsx ../sims/attack.ts",
    "compare": "tsx ../sims/compare.ts",
    "sims:test": "vitest run --config ../vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "ws": "8.22.0"
  }
}
